---
layout: null
sitemap: false
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  {% for post in site.posts %}
  <url>
    <loc>{{ post.url | absolute_url }}</loc>
    {% assign post_lastmod = post.last_modified_at | default: post.modified | default: post.date %}
    {% if post_lastmod %}<lastmod>{{ post_lastmod | date_to_xmlschema }}</lastmod>{% endif %}
  </url>
  {% endfor %}
  {% for page in site.html_pages %}
  {% unless page.sitemap == false or page.path contains '404' %}
  <url>
    <loc>{{ page.url | replace:'index.html','' | absolute_url }}</loc>
    {% if page.last_modified_at %}<lastmod>{{ page.last_modified_at | date_to_xmlschema }}</lastmod>{% endif %}
  </url>
  {% endunless %}
  {% endfor %}
</urlset>
